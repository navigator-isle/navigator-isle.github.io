{
  "name": "passage-planner-android",
  "version": "1.0.0",
  "private": true,
  "description": "Android (APK) wrapper for the Passage Planner web app",
  "scripts": {
    "copy-web": "node -e \"const fs=require('fs');fs.mkdirSync('www',{recursive:true});for(const f of ['index.html','manifest.webmanifest','privacy.html'])fs.copyFileSync('../'+f,'www/'+f);fs.cpSync('../icons','www/icons',{recursive:true})\"",
    "sync": "npm run copy-web && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}