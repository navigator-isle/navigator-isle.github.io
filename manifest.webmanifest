{
  "id": "./",
  "name": "Passage Planner – Voyage & Navigation Tools",
  "short_name": "Passage Plan",
  "description": "Berth-to-berth passage planning, waypoint actions, ETA, weather, squat, UKC and sailing calculators for ship officers. Planning aid only – not for navigation.",
